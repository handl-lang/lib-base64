--- `base64.encode` — pure-Handl base64 encoding (RFC 4648).
ALPHA := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

emit4 := (n) ~> do {
  char.at(ALPHA, math.shr(n, 18))
    + char.at(ALPHA, math.bit_and(math.shr(n, 12), 63))
    + char.at(ALPHA, math.bit_and(math.shr(n, 6), 63))
    + char.at(ALPHA, math.bit_and(n, 63))
}

base64_encode := (s) ~> do {
  acc := ""
  n := 0
  cnt := 0
  prev := 0
  last := 0
  for b in bytes.to_list(bytes.utf8_encode(s)) { do {
    prev := last
    last := b
    if cnt == 0 { do { n := math.shl(b, 16) } } else {
      if cnt == 1 { do { n := math.bit_or(n, math.shl(b, 8)) } } else { do {
        n := math.bit_or(n, b)
        acc := acc + emit4(n)
        n := 0
      } }
    }
    cnt := if cnt == 2 { 0 } else { cnt + 1 }
  } }
  if cnt == 1 { do {
    acc := acc
      + char.at(ALPHA, math.shr(math.shl(last, 16), 18))
      + char.at(ALPHA, math.bit_and(math.shr(math.shl(last, 16), 12), 63))
      + "=="
  } } else {
    if cnt == 2 { do {
      n := math.bit_or(math.shl(prev, 16), math.shl(last, 8))
      acc := acc
        + char.at(ALPHA, math.shr(n, 18))
        + char.at(ALPHA, math.bit_and(math.shr(n, 12), 63))
        + char.at(ALPHA, math.bit_and(math.shr(n, 6), 63))
        + "="
    } } else { do {} }
  }
  acc
}

--- `base64.decode` — pure-Handl base64 decoding (RFC 4648).
ALPHA := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

base64_decode := (s) ~> do {
  out := []
  q0 := 0
  q1 := 0
  q2 := 0
  cnt := 0
  for c in char.chars(s) { do {
    if c == "=" { do {} } else { do {
      v := str.find(ALPHA, c)
      if v < 0 { throw "base64.decode: invalid digit" } else { do {} }
      if cnt == 0 { do { q0 := math.shl(v, 18) } } else {
        if cnt == 1 { do { q1 := math.shl(v, 12) } } else {
          if cnt == 2 { do { q2 := math.shl(v, 6) } } else { do {
            n := math.bit_or(math.bit_or(q0, q1), math.bit_or(q2, v))
            out := [...out,
              math.bit_and(math.shr(n, 16), 255),
              math.bit_and(math.shr(n, 8), 255),
              math.bit_and(n, 255)]
          } }
        }
      }
      cnt := if cnt == 3 { 0 } else { cnt + 1 }
    } }
  } }
  if cnt == 2 { do {
    n := math.bit_or(q0, q1)
    out := [...out, math.bit_and(math.shr(n, 16), 255)]
  } } else {
    if cnt == 3 { do {
      n := math.bit_or(math.bit_or(q0, q1), q2)
      out := [...out,
        math.bit_and(math.shr(n, 16), 255),
        math.bit_and(math.shr(n, 8), 255)]
    } } else { do {} }
  }
  bytes.utf8_decode(bytes.from_list(out))
}

--- base64.encode -- encode a string to base64 (RFC 4648).
--- base64.decode -- decode a base64 string.
cap "base64.encode"
cap "base64.decode"
op "base64.encode" : String -> String
  guarantee: IsBase64(output)
op "base64.decode" : String -> String
  guarantee: True

--- pure-handl impls (the module arrows):

export encode := base64_encode
export decode := base64_decode
export codec := () ~> ({ "type": "codec", "name": "base64", "encode": base64_encode, "decode": base64_decode })
