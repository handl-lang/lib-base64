--- base64.encode -- encode a string to base64 (RFC 4648).
--- base64.decode -- decode a base64 string.
cap "base64.encode"
cap "base64.decode"
op "base64.encode" : String ~> String
  guarantee: IsBase64(output)
op "base64.decode" : String ~> String
  guarantee: True

--- pure-handl impls (the module arrows):
from "./encode.hnl" export encode
from "./decode.hnl" export decode

cap "base64.codec"
op "base64.codec" : () ~> Value
export codec := () ~> ({ "type": "codec", "name": "base64", "encode": encode, "decode": decode })
